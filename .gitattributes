# Force LF line endings so Dockerfiles, shell entrypoints, and configs keep
# Unix line endings when the repo is cloned on a Windows Server. CRLF breaks
# `sh -c` entrypoints and nginx/postgres scripts inside the Linux containers.
* text=auto eol=lf

# Explicitly LF for the files that run inside containers
*.sh        text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Treat these as binary (never normalize)
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
