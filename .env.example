# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://erp:erp_dev@localhost:5432/erp_db

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-random-64-char-string-in-production
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# ─── API Server ───────────────────────────────────────────────────────────────
API_PORT=3000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Production only (docker-compose.yml) ────────────────────────────────────
# Uncomment + set these for an on-prem deploy. For production, CORS_ORIGIN above
# should be http://<server-ip> (or your hostname), not the dev :5173 origin.
# POSTGRES_DB=erp_db
# POSTGRES_USER=erp
# POSTGRES_PASSWORD=change-me-strong-password
# TZ=Asia/Kolkata                 # container timezone (fiscal/GST timestamps)
# HTTP_PORT=80                    # host port for the web UI; use 8080 if IIS owns 80
# DB_BOOTSTRAP=migrate            # 'migrate' (committed migrations) or 'push' (greenfield, no migration files)
